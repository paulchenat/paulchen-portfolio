      width: 100%;
    }

    @media (max-width: 768px) {
      .nav-grid { grid-template-columns: repeat(6, 1fr); padding-left: 24px; padding-right: 24px; }
      .content-grid { grid-template-columns: repeat(6, 1fr); padding-left: 40px; padding-right: 40px; }
    }

