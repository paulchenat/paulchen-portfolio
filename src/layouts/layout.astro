          imgCount++;
          imgBytes += size;
        }
        if (r.initiatorType === 'video' || r.name.match(/\.(mp4|webm)$/i)) {
          mediaCount++;
          mediaBytes += size;
        }
      }

      const domImgs = document.querySelectorAll('img');
