      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      transition: transform 0.2s ease;
    }
    .perf-badge:hover { transform: scale(1.05); }

    .perf-dot { width: 8px; height: 8px; border-radius: 50%; background-color: #22c55e; }
    .perf-badge.heavy .perf-dot { background-color: #ef4444; }
