      let imgCount = 0;
      let imgBytes = 0;
      let mediaCount = 0;
      let mediaBytes = 0;

      for (const r of resources) {
        let size = r.transferSize || r.encodedBodySize || r.decodedBodySize || 0;
        
        if (size === 0 && r.name && (r.name.includes('/images/') || r.name.includes('/uploads/'))) {
