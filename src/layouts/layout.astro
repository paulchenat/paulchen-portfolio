<body>
  <slot />

  <!-- PERFORMANCE INSPECTOR BADGE -->
  <aside class="perf-badge-container" id="perfContainer">
    <div class="perf-badge" id="perfBadge" title="Klicken für Payload-Details">
      <span class="perf-dot" id="perfDot"></span>
      <span id="perfText">⚡ Messung...</span>
    </div>
    <div class="perf-details-modal" id="perfModal">
      <div style="font-weight: 500; margin-bottom: 6px; border-bottom: 1px solid #333; padding-bottom: 4px;">Page Performance Inspector</div>
      <div id="perfBreakdown">Analysiere Assets...</div>
      <div style="margin-top: 8px; font-size: 10px; color: #888;">Tastenkürzel: Shift + P zum Umschalten</div>
    </div>
  </aside>

  <script is:inline>
    function togglePerfBadge() {
      const container = document.getElementById('perfContainer');
      if (container) {
        const isHidden = container.style.display === 'none' || getComputedStyle(container).display === 'none';
        container.style.display = isHidden ? 'block' : 'none';
        if (isHidden) runPayloadMeasurement();
      }
    }

    let clickCount = 0;
    let clickTimer = null;

    document.addEventListener('click', (e) => {
      const brand = e.target.closest('.nav-brand');
      if (brand) {
        clickCount++;
        if (clickCount === 1) {
          clickTimer = setTimeout(() => { clickCount = 0; }, 500);
        } else if (clickCount >= 3) {
          e.preventDefault();
          e.stopPropagation();
          clickCount = 0;
          clearTimeout(clickTimer);
          togglePerfBadge();
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.shiftKey && (e.key === 'P' || e.key === 'p')) {
        togglePerfBadge();
      }
    });

