---
export const prerender = true;
import Layout from '../layouts/layout.astro';

const privacyFiles = import.meta.glob('../content/singletons/privacyPolicy.json', { eager: true });
const privacyMod: any = Object.values(privacyFiles)[0];
const data = privacyMod?.default || privacyMod || {};

function parseFormattedText(text: string) {
  if (!text) return '';
  return text
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="wavy-link">$1</a>')
    .replace(/~(.*?)~/g, '<span class="wavy-text">$1</span>');
}

const title = data.title || 'Privacy Policy';
const intro = data.intro || 'Your privacy is important to me. This website is built with a privacy-first approach and does not track you.';
const content = data.content || '';
---

<Layout title={`${title} — paulchen.at`}>
  <header class="sticky-nav nav-grid">
    <div class="nav-brand">
      <a href="/" class="wavy-link">paulchen.at</a>
    </div>
    <div class="nav-bio">
      <a href="mailto:hallo@paulchen.at" class="wavy-link">write me</a>
    </div>
    <div class="nav-more">
      <a href="/" class="hover-wavy">← Zurück</a>
    </div>
  </header>

  <main class="content-grid" style="padding-top: 140px; padding-bottom: 120px;">
    <div style="grid-column: 1 / -1; max-width: 750px; font-size: 16px; line-height: 1.4;">
      <h1 style="font-size: 40px; font-weight: 400; margin-bottom: 40px;">{title}</h1>
      
      {intro && (
        <p style="margin-bottom: 24px; font-size: 20px; white-space: pre-line !important;" set:html={parseFormattedText(intro)} />
      )}

      <div style="white-space: pre-line !important;" set:html={parseFormattedText(content)} />
    </div>
  </main>

  <style>
    .sticky-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 999; background: transparent; padding-top: 20px; padding-bottom: 20px; font-size: 24px; }
    .nav-brand { grid-column: 1 / 3; }
    .nav-bio { grid-column: 3 / 11; }
    .nav-more { grid-column: 11 / 13; text-align: right; }
  </style>
</Layout>
