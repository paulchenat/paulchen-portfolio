            <span>[Nächstes Projekt: {nextProject.data?.title || 'Projekt'}]</span>
          </div>
        </div>
        <div class="project-info-block">
          <div class="info-col">
            <div class="slot-3-rows"><p>{nextProject.data?.title || ''}</p></div>
            <p>{nextProject.data?.year || ''}</p>
          </div>
          <div class="info-col">
            <div class="slot-3-rows"><p>{nextProject.data?.furtherContext || ''}</p></div>
            <p>{nextProject.data?.copyright || ''}</p>
          </div>
        </div>
      </article>
    )}

  </main>

  <style>
    .sticky-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 999; background: transparent; padding-top: 20px; padding-bottom: 20px; font-size: 24px; pointer-events: none; color: var(--text-color); transition: color 0.4s ease; }
