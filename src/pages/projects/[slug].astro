---
export const prerender = true;
import Layout from '../../layouts/layout.astro';

export async function getStaticPaths() {
  const projectFiles = import.meta.glob('../../content/selected-projects/*.json', { eager: true });
  const allProjects = Object.entries(projectFiles)
    .map(([path, mod]: any) => {
      const slug = path.split('/').pop()?.replace('.json', '') || 'projekt';
      const data = mod?.default || mod || {};
      return { slug, data };
    })
    .sort((a, b) => (Number(a.data.order) || 999) - (Number(b.data.order) || 999));

  return allProjects.map((proj) => ({
    params: { slug: proj.slug },
    props: { project: proj, allProjects },
  }));
}

const allProjects = Astro.props.allProjects || [];
const project = Astro.props.project || allProjects[0] || { slug: 'projekt', data: {} };

// Endlose Kette aller Projekte, beginnend beim aktuellen Projekt
const currentIndex = allProjects.findIndex((p: any) => p.slug === project.slug);
const orderedStream = allProjects.length > 0
  ? [
      ...allProjects.slice(currentIndex >= 0 ? currentIndex : 0),
      ...allProjects.slice(0, currentIndex >= 0 ? currentIndex : 0)
    ]
  : [project];

const settingsFiles = import.meta.glob('../../content/singletons/settings.json', { eager: true });
const settingsMod: any = Object.values(settingsFiles)[0];
const settings: any = settingsMod?.default || settingsMod || {};

function parseFormattedText(text: string) {
  if (!text) return '';
  return text
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="wavy-link">$1</a>')
    .replace(/~(.*?)~/g, '<span class="wavy-text">$1</span>');
}

const brandName = settings.brandName || 'paulchen.at';
const navbarBio = settings.navbarBio || 'paul neuburger’s archive showcases ~conceptual thinking~, driven by a heavy focus on visual solutions and authentic new ways to communicate. Specialising in ~typography~ and spaces loaded with orientation and ~identity~.';
const contactLabel = settings.contactLinkText || 'write me';
const contactPrefix = settings.contactType === 'email' ? 'mailto:' : settings.contactType === 'tel' ? 'tel:' : '';
const contactHref = settings.contactTarget ? `${contactPrefix}${settings.contactTarget}` : 'mailto:hallo@paulchen.at';
const moreLabel = settings.moreButtonText || 'mehr';
---

<Layout title={`${project.data?.title || 'Projekt'} — paulchen.at`}>
  
  <!-- NAVBAR -->
  <header class="sticky-nav nav-grid" id="mainNav">
    <div class="nav-brand">
      <a href="/" class="wavy-link">{brandName}</a>
    </div>
    
    <div class="nav-bio">
      <span set:html={parseFormattedText(navbarBio)} /> <a href={contactHref} class="wavy-link">{contactLabel}</a>
    </div>

    <div class="nav-mobile-collapsed">
      <a href={contactHref} class="wavy-link">{contactLabel}</a>
    </div>

    <div class="nav-more">
      <a href="/ueber-mich" class="hover-wavy">{moreLabel}</a>
    </div>
  </header>

  <!-- ENDLOSER PROJEKT STREAM -->
  <main class="content-grid" id="projectContainer">
    
    {orderedStream.map((item: any, streamIdx: number) => {
      const d = item.data || {};
      return (
        <div class="project-stream-wrapper" style="grid-column: 1 / -1; display: contents;">
          {streamIdx > 0 && (
            <div class="next-project-divider">
              <span>— Nächstes Projekt: {d.title || ''} —</span>
            </div>
          )}

          <article class="project-case-wrapper" 
                   data-bg={d.theme?.backgroundColor || '#ffffff'} 
                   data-text={d.theme?.textColor || '#000000'}
                   data-theme={d.theme?.isDarkTheme ? 'dark' : 'light'}>
            
            <!-- 1. Header Bild -->
            <div class="media-box block-hero">
              {d.heroDesktop ? (
                <img 
                  src={d.heroDesktop} 
                  alt={d.title || ''} 
                  fetchpriority={streamIdx === 0 ? "high" : "low"} 
                  loading={streamIdx === 0 ? "eager" : "lazy"} 
                  decoding="async" 
                />
              ) : (
                <div class="color-placeholder" style="background:#e5e510; color:#000;">
                  <span>3:4 / 2:1 Header Media</span>
                </div>
              )}
            </div>

            <!-- 2. Projekt-Info -->
            <div class="project-info-block">
              <div class="info-col">
                <div class="slot-3-rows">
                  <p>{d.title || ''}</p>
                </div>
                <p>{d.year || ''} {d.location || ''}</p>
              </div>
              <div class="info-col">
                <div class="slot-3-rows">
                  <p>{d.furtherContext || ''}</p>
                </div>
                <p>{d.copyright || ''}</p>
              </div>
            </div>

            <!-- 3. Modulare Blöcke (Vollständig abgesichert) -->
            {Array.isArray(d.blocks) && d.blocks.map((block: any) => {
              if (!block) return null;
              const val = block.value || {};

              if (block.discriminant === 'portraitWithText') {
                return (
                  <section class="block-portrait-with-text">
                    <div class={`portrait-text-left ${val.textSize === 'large' ? 'text-large' : 'text-normal'}`}>
                      <div class="text-wrapper">
                        <p set:html={parseFormattedText(val.text)} />
                      </div>
                    </div>
                    <div class="media-box portrait-media-right">
                      {val.media && <img src={val.media} alt="" loading="lazy" decoding="async" />}
                      {val.videoUrl && (
                        <video playsinline loop muted autoplay>
                          <source src={val.videoUrl} type="video/mp4" />
                        </video>
                      )}
                    </div>
                  </section>
                );
              }
              if (block.discriminant === 'landscapeStandard') {
                return (
                  <div class="media-box block-landscape-standard">
                    {val.media && <img src={val.media} alt="" loading="lazy" decoding="async" />}
                    {val.videoUrl && (
                      <video playsinline loop muted autoplay>
                        <source src={val.videoUrl} type="video/mp4" />
                      </video>
                    )}
                  </div>
                );
              }
              if (block.discriminant === 'centeredStatement') {
                return (
                  <div class={`block-centered-text ${val.textSize === 'large' ? 'large' : 'normal'}`}>
                    <p set:html={parseFormattedText(val.statement)} />
                  </div>
                );
              }
              if (block.discriminant === 'landscapeFullWidth') {
                return (
                  <div class="media-box block-landscape-fullwidth">
                    {val.media && <img src={val.media} alt="" loading="lazy" decoding="async" />}
                    {val.videoUrl && (
                      <video playsinline loop muted autoplay>
                        <source src={val.videoUrl} type="video/mp4" />
                      </video>
                    )}
                  </div>
                );
              }
              if (block.discriminant === 'portraitNoText') {
                return (
                  <section class={`block-portrait-no-text ${val.mobileFullWidth ? 'block-portrait-mobile-fullwidth' : ''}`}>
                    <div class="media-box portrait-only-media">
                      {val.media && <img src={val.media} alt="" loading="lazy" decoding="async" />}
                      {val.videoUrl && (
                        <video playsinline loop muted autoplay>
                          <source src={val.videoUrl} type="video/mp4" />
                        </video>
                      )}
                    </div>
                  </section>
                );
              }
              return null;
            })}

          </article>
        </div>
      );
    })}

  </main>

  <style>
    .sticky-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 999; background: transparent; padding-top: 20px; padding-bottom: 20px; font-size: 24px; pointer-events: none; color: var(--text-color); transition: color 0.4s ease; }
    .sticky-nav a, .sticky-nav span { pointer-events: auto; }
    .nav-brand { grid-column: 1 / 3; }
    .nav-bio { grid-column: 3 / 11; }
    .nav-more { grid-column: 11 / 13; text-align: right; }
    .nav-mobile-collapsed { display: none; }

    main { padding-top: 140px; padding-bottom: 160px; width: 100%; }
    .project-case-wrapper { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; width: 100%; padding-bottom: 60px; }

    .media-box { position: relative; width: 100%; background-color: transparent; border: none !important; overflow: hidden; }
    .media-box img, .media-box video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .color-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 16px; }

    .block-hero { grid-column: 1 / -1; aspect-ratio: 2 / 1; margin-bottom: 20px; }
    .project-info-block { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; font-size: 16px; line-height: 1.2; margin-bottom: 60px; }
    .info-col { display: flex; flex-direction: column; justify-content: space-between; }
    .slot-3-rows { min-height: 57.6px; margin-bottom: 4px; }

    .block-portrait-with-text { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; align-items: start; margin-bottom: 60px; }
    .portrait-text-left { grid-column: 1 / 7; padding-top: 24px; }
    .portrait-text-left.text-normal .text-wrapper { font-size: 24px; line-height: 1.2; width: 66.666%; }
    .portrait-text-left.text-large .text-wrapper { font-size: 40px; line-height: 1.2; width: 66.666%; }
    .portrait-media-right { grid-column: 7 / 13; aspect-ratio: 3 / 4; }

    .block-landscape-standard { grid-column: 1 / -1; aspect-ratio: 3 / 2; margin-bottom: 60px; }
    .block-centered-text { grid-column: 1 / -1; text-align: center; margin-top: 60px; margin-bottom: 120px; padding: 60px 0; }
    .block-centered-text.large { font-size: 40px; line-height: 1.2; max-width: 850px; margin-left: auto; margin-right: auto; }
    .block-centered-text.normal { font-size: 24px; line-height: 1.2; max-width: 650px; margin-left: auto; margin-right: auto; }

    .block-landscape-fullwidth { grid-column: 1 / -1; width: calc(100% + (var(--content-margin) * 2)); margin-left: calc(-1 * var(--content-margin)); aspect-ratio: 3 / 2; margin-bottom: 60px; }
    .block-portrait-no-text { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; margin-bottom: 60px; }
    .portrait-only-media { grid-column: 7 / 13; aspect-ratio: 3 / 4; }

    .next-project-divider { grid-column: 1 / -1; margin-top: 80px; margin-bottom: 60px; text-align: center; font-size: 16px; color: #888; letter-spacing: 0.5px; }

    @media (max-width: 768px) {
      .project-case-wrapper { grid-template-columns: repeat(6, 1fr); }
      .sticky-nav { font-size: 20px; padding-top: 16px; padding-bottom: 16px; }
      .nav-brand { grid-column: 1 / 7; margin-bottom: 8px; }
      .nav-bio { display: none; }
      .nav-mobile-collapsed { display: block; grid-column: 1 / 7; margin-bottom: 8px; }
      .nav-more { grid-column: 1 / 7; text-align: left; }

      main { padding-top: 55px; padding-bottom: 80px; }
      .block-hero { aspect-ratio: 3 / 4; margin-top: 0; margin-bottom: 20px; }
      .project-info-block { grid-template-columns: 1fr 1fr; column-gap: 16px; margin-bottom: 60px; }
      .slot-3-rows { min-height: 57.6px; }

      .block-portrait-with-text { grid-template-columns: 1fr; row-gap: 28px; margin-bottom: 60px; }
      .portrait-media-right { grid-column: 1 / -1; order: 1; }
      .portrait-text-left { grid-column: 1 / -1; order: 2; padding-top: 0; margin-bottom: 12px; }
      .portrait-text-left.text-normal .text-wrapper { font-size: 20px; width: 100%; }
      .portrait-text-left.text-large .text-wrapper { font-size: 30px; width: 100%; }

      .block-landscape-standard { margin-bottom: 60px; }
      .block-centered-text { margin-top: 40px; margin-bottom: 80px; padding: 20px 0; }
      .block-centered-text.large { font-size: 30px; }

      .block-landscape-fullwidth { width: calc(100% + 80px); margin-left: -40px; margin-bottom: 60px; }
      .block-portrait-no-text { grid-template-columns: 1fr; margin-bottom: 60px; }
      .portrait-only-media { grid-column: 1 / -1; }
      .block-portrait-mobile-fullwidth .media-box { width: calc(100% + 80px); margin-left: -40px; }
    }
  </style>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const bg = entry.target.getAttribute('data-bg');
          const text = entry.target.getAttribute('data-text');
          const theme = entry.target.getAttribute('data-theme');
          document.documentElement.style.setProperty('--bg-color', bg);
          document.documentElement.style.setProperty('--text-color', text);
          if (theme === 'dark') {
            document.body.classList.add('theme-dark');
          } else {
            document.body.classList.remove('theme-dark');
          }
        }
      });
    }, { rootMargin: '-30% 0px -50% 0px', threshold: 0 });

    document.querySelectorAll('.project-case-wrapper').forEach(p => observer.observe(p));
  </script>
</Layout>    <div class="nav-mobile-collapsed">
