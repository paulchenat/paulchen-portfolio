---
export const prerender = true;
import Layout from '../layouts/layout.astro';

const projectFiles = import.meta.glob('../content/selected-projects/*.json', { eager: true });
const archiveFiles = import.meta.glob('../content/archive/*.json', { eager: true });
const settingsFiles = import.meta.glob('../content/singletons/settings.json', { eager: true });
const seoFiles = import.meta.glob('../content/singletons/seo.json', { eager: true });

function getProjectThumbnails(d: any) {
  const thumb = d.thumbnails || {};
  const mobileImage = d.thumbnailMobile || thumb.mobileImage || null;
  const mobileVideo = d.mobileVideoLoop || thumb.mobileVideoLoop || null;
  let desktopImages: string[] = [];
  if (Array.isArray(d.thumbnailsDesktop) && d.thumbnailsDesktop.length > 0) {
    desktopImages = d.thumbnailsDesktop;
  } else if (Array.isArray(thumb.desktopScrubImages) && thumb.desktopScrubImages.length > 0) {
    desktopImages = thumb.desktopScrubImages;
  }
  const desktopVideo = d.videoLoopFile || d.videoLoop || thumb.desktopVideoLoop || null;
  return { mobileImage, mobileVideo, desktopImages, desktopVideo };
}

const seenProjects = new Set();
const projects = Object.entries(projectFiles)
  .map(([path, mod]: any) => {
    const slug = path.split('/').pop()?.replace('.json', '') || 'projekt';
    const data = mod?.default || mod || {};
    return { slug, data };
  })
  .filter((proj) => {
    const identifier = proj.data.title || proj.slug;
    if (seenProjects.has(identifier)) return false;
    seenProjects.add(identifier);
    return true;
  })
  .sort((a, b) => (Number(a.data.order) || 999) - (Number(b.data.order) || 999));

const seenArchive = new Set();
const archiveRows = Object.values(archiveFiles)
  .map((mod: any) => mod?.default || mod || {})
  .filter((row: any) => {
    const identifier = row.title || JSON.stringify(row);
    if (seenArchive.has(identifier)) return false;
    seenArchive.add(identifier);
    return true;
  })
  .sort((a: any, b: any) => (Number(a.order) || 999) - (Number(b.order) || 999));

const settingsMod: any = Object.values(settingsFiles)[0] || {};
const settings: any = settingsMod?.default || settingsMod || {};
const seoMod: any = Object.values(seoFiles)[0] || {};
const seo: any = seoMod?.default || seoMod || {};

function parseFormattedText(text: string) {
  if (!text) return '';
  return text
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="wavy-link">$1</a>')
    .replace(/~(.*?)~/g, '<span class="wavy-text">$1</span>');
}

const brandName = settings.brandName || 'paulchen.at';
const navbarBio = settings.navbarBio || 'paul neuburger’s archive showcases ~conceptual thinking~, driven by a heavy focus on visual solutions and authentic new ways to communicate. Specialising in ~typography~ and spaces loaded with orientation and ~identity~.';
const contactLabel = settings.contactLinkText || 'write me';
const contactPrefix = settings.contactType === 'email' ? 'mailto:' : settings.contactType === 'tel' ? 'tel:' : '';
const contactHref = settings.contactTarget ? `${contactPrefix}${settings.contactTarget}` : 'mailto:hallo@paulchen.at';
const moreLabel = settings.moreButtonText || 'mehr';
const selectedWorkTitle = settings.selectedWorkTitle || 'Ausgewählte Projekte';
const archiveTitle = settings.archiveTitle || 'Archiv';
const footerText = settings.footerText || 'Your privacy matters to me. When you browse my design work on paulchen.at, your visit remains completely anonymous, ~no cookies~ are stored, tracked, or shared with third parties.\n\nYou can find all legal details regarding my identity in the [Imprint](/imprint) and full information about data handling in the [Privacy Policy](/privacy-policy).\n\nHave a wonderful day!\nBest, Paul';
---

<Layout 
  title={seo.siteTitle || "paulchen.at — Creative Direction & Archive"}
  description={seo.metaDescription}
  ogImage={seo.ogImage}
  favicon={seo.favicon}
>
  
  <div class="hero-top-spacer" id="topSpacer"></div>

  <!-- NAVBAR -->
  <header class="sticky-nav nav-grid" id="mainNav">
    <div class="nav-brand">
      <a href="/" class="wavy-link">{brandName}</a>
    </div>
    
    <div class="nav-bio-accordion">
      <div class="nav-bio-inner">
        <span set:html={parseFormattedText(navbarBio)} /> <a href={contactHref} class="wavy-link">{contactLabel}</a>
      </div>
    </div>

    <div class="nav-collapsed-link">
      <div class="nav-collapsed-inner">
        <a href={contactHref} class="wavy-link">{contactLabel}</a>
      </div>
    </div>

    <div class="nav-more">
      <a href="/ueber-mich" class="hover-wavy">{moreLabel}</a>
    </div>
  </header>

  <div class="hero-bottom-spacer"></div>

  <main>
    
    <!-- SELECTED WORK (+50% ABSTAND NACH UNTEN) -->
    <section class="selected-section content-grid">
      <div style="grid-column: 1 / -1;">
        <h2 class="section-title">{selectedWorkTitle}</h2>
        
        <div class="selected-grid">
          {projects.length > 0 ? (
            projects.map((proj) => {
              const d = proj.data || {};
              const { mobileImage, mobileVideo, desktopImages, desktopVideo } = getProjectThumbnails(d);

              return (
                <article class="work-card">
                  <a href={`/projects/${proj.slug}`} style="color:inherit; text-decoration:none;">
                    <div class="scrub-container">
                      <div class="mobile-thumb-box">
                        {mobileVideo ? (
                          <video src={mobileVideo} autoplay loop muted playsinline class="thumb-media-full" />
                        ) : mobileImage ? (
                          <img src={mobileImage} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : desktopVideo ? (
                          <video src={desktopVideo} autoplay loop muted playsinline class="thumb-media-full" />
                        ) : desktopImages.length > 0 ? (
                          <img src={desktopImages[0]} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : (
                          <div class="color-placeholder"><span>3:4</span></div>
                        )}
                      </div>

                      <div class="desktop-thumb-box">
                        {desktopVideo ? (
                          <video src={desktopVideo} autoplay loop muted playsinline class="thumb-media-full" />
                        ) : desktopImages.length > 0 ? (
                          desktopImages.map((imgSrc: string, idx: number) => (
                            <img 
                              src={imgSrc} 
                              alt={d.title || ''} 
                              class={`scrub-item ${idx === 0 ? 'active' : ''}`}
                              loading={idx === 0 ? "eager" : "lazy"}
                              decoding="async"
                            />
                          ))
                        ) : mobileImage ? (
                          <img src={mobileImage} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : (
                          <div class="color-placeholder"><span>4:3</span></div>
                        )}
                      </div>
                    </div>
                  </a>
                  
                  <div class="card-meta">
                    <div class="meta-title"><p>{d.title || ''}</p></div>
                    <div class="meta-context"><p>{d.furtherContext || ''}</p></div>
                    <div class="meta-year-place"><p>{d.year || ''} {d.location || ''}</p></div>
                    <div class="meta-copyright"><p>{d.copyright || ''}</p></div>
                  </div>
                </article>
              );
            })
          ) : (
            <p style="grid-column: 1 / -1; font-size: 16px; color: #888;">Keine Projekte angelegt.</p>
          )}
        </div>
      </div>
    </section>

    <!-- ARCHIV HEADER MIT ZEIT-SORTIERUNG (SPALTE 5) & SUCHE (SPALTE 10) -->
    <section class="archive-section content-grid">
      
      <div class="archive-header-grid" style="grid-column: 1 / -1;">
        
        <!-- SPALTE 1-4: TITEL -->
        <h2 class="section-title arch-title-col">{archiveTitle}</h2>

        <!-- SPALTE 5: DESKTOP ZEIT-SORTIERUNG -->
        <div class="arch-sort-col">
          <button id="timeSortBtn" class="arch-control-btn" type="button">
            <span>Zeit</span>
            <svg class="sort-arrow" viewBox="0 0 10 12" width="9" height="11">
              <path d="M5 1v10M5 11l3.5-3.5M5 11L1.5 7.5" fill="none" stroke="#ff0000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <!-- SPALTE 10-12: DESKTOP SUCHE MIT 40PX DYNAMISCHEM MITLAUF -->
        <div class="arch-search-col">
          <!-- Unsichtbarer Mirror zum Messen der getippten Textbreite -->
          <span id="searchMirror" class="search-mirror"></span>
          
          <div class="search-wrapper" id="searchWrapper">
            <input type="text" id="archSearchInput" class="arch-search-input" placeholder="" autocomplete="off" />
            <button id="archSearchBtn" class="arch-control-btn search-btn" type="button">
              <span class="search-btn-text">Suchen</span>
              <span class="search-reset-icon">✕</span>
            </button>
          </div>
        </div>

        <!-- MOBILE UHR-ICON SORTIERUNG (NUR AUF SMARTPHONES) -->
        <div class="mobile-arch-controls">
          <button id="mobileTimeSortBtn" class="mobile-clock-btn" type="button" aria-label="Nach Zeit sortieren">
            <svg class="clock-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <svg class="sort-arrow-mobile" viewBox="0 0 10 12" width="10" height="12">
              <path d="M5 1v10M5 11l3.5-3.5M5 11L1.5 7.5" fill="none" stroke="#ff0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

      </div>

      <!-- ARCHIV PROJEKTZEILEN -->
      <div id="archiveContainer" style="grid-column: 1 / -1; width: 100%;">
        {archiveRows.map((row: any, rIdx: number) => {
          const rowSlug = (row.title || 'item').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
          const searchableText = `${row.title || ''} ${row.year || ''} ${row.furtherContext || ''} ${row.infoText || ''} ${row.keywords || ''}`.toLowerCase();

          return (
            <div 
              class="archive-project-row" 
              data-year={row.year || '0'} 
              data-order={row.order || rIdx} 
              data-search={searchableText}
            >
              <div class="archive-carousel-bleed">
                {row.gallery && row.gallery.map((item: any, gIdx: number) => {
                  const videoSrc = item.videoFile || item.videoUrl || '';
                  const itemId = `${rowSlug}-${gIdx + 1}`;
                  return (
                    <div 
                      class="archive-item-flow" 
                      data-id={itemId}
                      data-title={row.title || ''} 
                      data-year={row.year || ''} 
                      data-copyright={row.copyright || ''}
                      data-src={item.mediaFile || ''}
                      data-video={videoSrc}
                    >
                      {(item.isVideo || videoSrc) && <div class="video-badge">Video</div>}
                      {videoSrc ? (
                        <video 
                          src={videoSrc} 
                          muted 
                          loop 
                          playsinline 
                          webkit-playsinline 
                          preload="metadata"
                          class="archive-media-flow" 
                        />
                      ) : item.mediaFile ? (
                        <img 
                          src={item.mediaFile} 
                          alt={row.title || ''} 
                          loading="lazy" 
                          decoding="async" 
                          class="archive-media-flow"
                        />
                      ) : (
                        <div class="color-placeholder-flow">1:1</div>
                      )}
                    </div>
                  );
                })}
              </div>
              
              <!-- 12-SPALTEN RASTER -->
              <div class="archive-meta-grid">
                <div class="arch-name">{row.title || ''}</div>
                <div class="arch-year">({row.year || ''})</div>
                <div class="arch-context">{row.furtherContext || ''}</div>
                <div class="arch-info">
                  <span class="arch-info-btn">Info</span>
                  <div class="info-popover">{row.infoText || ''}</div>
                </div>
                <div class="arch-copyright">{row.copyright || ''}</div>
              </div>

              <!-- MOBILE INFO DRAWER -->
              <div class="mobile-info-drawer">
                {row.furtherContext && <div class="drawer-context">Mitwirkende: {row.furtherContext} ({row.year || ''})</div>}
                {row.infoText && <div class="drawer-desc">{row.infoText}</div>}
                {row.copyright && <div class="drawer-copyright">© {row.copyright}</div>}
              </div>
            </div>
          );
        })}
        <div id="noSearchMatches" style="display: none; padding: 40px 0; font-size: 16px; color: #999;">Keine Treffer im Archiv gefunden.</div>
      </div>

    </section>

    <!-- FOOTER -->
    <footer class="content-grid site-footer">
      <div class="footer-text-col">
        <p set:html={parseFormattedText(footerText)} />
      </div>
    </footer>

  </main>

  <!-- LIGHTBOX -->
  <div class="lightbox-modal" id="globalLightbox">
    <div class="lightbox-header">
      <span id="lbTitle">Projekt Titel</span>
      <span style="cursor:pointer;" id="lbClose" class="hover-wavy">(Close ✕)</span>
    </div>
    <div class="lightbox-stage" id="lbStage">
      <div id="lbMedia">[ Lade Bild... ]</div>
    </div>
    <div class="lightbox-footer">
      <span id="lbContext">Global Archive</span>
      <div class="lightbox-arrows">
        <button id="lbPrev" class="arrow-btn hover-wavy" aria-label="Vorheriges">←</button>
        <button id="lbNext" class="arrow-btn hover-wavy" aria-label="Nächstes">→</button>
      </div>
      <span id="lbCopyright">© Copyright</span>
    </div>
  </div>

  <style>
    .hero-top-spacer { height: calc(50vh - 85px); width: 100%; }
    .hero-bottom-spacer { height: calc(50vh + 100px); width: 100%; }

    .sticky-nav { position: sticky; top: 0; z-index: 999; background: transparent; padding-top: 20px; padding-bottom: 20px; font-size: 24px; pointer-events: none; }
    .sticky-nav a, .sticky-nav span { pointer-events: auto; }
    .nav-brand { grid-column: 1 / 3; }
    
    .nav-bio-accordion { grid-column: 3 / 11; display: block; opacity: 1; }
    .nav-bio-inner { font-size: 24px; line-height: 1.2; white-space: pre-line !important; }
    .nav-collapsed-link { display: none; }

    .nav-more { grid-column: 11 / 13; text-align: right; }

    /* +50% MEHR ABSTAND ZWISCHEN SELECTED WORK UND ARCHIV (270PX DKT) */
    .selected-section { padding-bottom: 270px; }
    .section-title { font-size: 24px; margin-bottom: 0; font-weight: 400; line-height: 1.2; }
    .selected-grid { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 20px; row-gap: 60px; margin-top: 24px; }

    .work-card { display: flex; flex-direction: column; }
    
    .scrub-container { 
      position: relative; 
      width: 100%; 
      aspect-ratio: 4 / 3; 
      background-color: transparent !important; 
      border: none !important;
      overflow: hidden; 
      margin-bottom: 14px; 
    }
    
    .scrub-item { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none; transition: opacity 0.04s ease; background: transparent; }
    .scrub-item.active { opacity: 1; }

    .mobile-thumb-box { display: none; }
    .desktop-thumb-box { display: block; width: 100%; height: 100%; position: relative; cursor: crosshair; background: transparent; }
    .thumb-media-full { 
      position: absolute; 
      inset: 0; 
      width: 100%; 
      height: 100%; 
      object-fit: cover; 
      background: transparent;
      pointer-events: none !important;
    }

    .color-placeholder { 
      position: absolute; 
      inset: 0; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center; 
      color: inherit; 
      font-size: 16px; 
      font-weight: 500; 
      letter-spacing: 0.5px;
      background: transparent !important;
      border: 1px dashed rgba(128,128,128,0.3);
    }

    .card-meta { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; font-size: 16px; line-height: 1.2; }
    .card-meta p { white-space: pre-line !important; }
    .meta-title { grid-column: 1; grid-row: 1; min-height: 57.6px; }
    .meta-year-place { grid-column: 1; grid-row: 2; }
    .meta-context { grid-column: 2; grid-row: 1; min-height: 57.6px; }
    .meta-copyright { grid-column: 2; grid-row: 2; }

    /* ==========================================================================
       ARCHIV HEADER: 12-SPALTEN-RASTER MIT ZEIT (SPALTE 5) & SUCHE (SPALTE 10)
       ========================================================================== */
    .archive-section { padding-bottom: 60px; overflow-x: hidden; }
    
    .archive-header-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: 20px;
      align-items: baseline;
      margin-bottom: 24px;
      width: 100%;
    }

    .arch-title-col { grid-column: 1 / 5; }

    /* ZEIT-BUTTON IN SPALTE 5 */
    .arch-sort-col { grid-column: 5 / 6; display: flex; align-items: center; }
    
    .arch-control-btn {
      background: none;
      border: none;
      font-family: inherit;
      font-size: 24px;
      line-height: 1.2;
      color: #999999;
      cursor: pointer;
      padding: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s ease;
      user-select: none;
      text-decoration: none !important;
    }

    .arch-control-btn:hover { color: #000000; }
    .arch-control-btn.active { color: #000000; }

    .sort-arrow {
      display: none;
      transition: transform 0.2s ease;
    }
    .arch-control-btn.active .sort-arrow { display: inline-block; }
    .arch-control-btn.asc .sort-arrow { transform: rotate(180deg); }

    /* SUCHE IN SPALTE 10-12 MIT 40PX MITLAUFENDEM BUTTON */
    .arch-search-col {
      grid-column: 10 / 13;
      display: flex;
      align-items: baseline;
      position: relative;
    }

    .search-mirror {
      position: absolute;
      visibility: hidden;
      height: 0;
      white-space: pre;
      font-size: 24px;
      font-family: inherit;
      line-height: 1.2;
    }

    .search-wrapper {
      display: inline-flex;
      align-items: baseline;
      max-width: 100%;
      position: relative;
    }

    .arch-search-input {
      width: 0px;
      opacity: 0;
      border: none;
      outline: none;
      background: transparent;
      font-family: inherit;
      font-size: 24px;
      line-height: 1.2;
      color: #000000;
      caret-color: #000000;
      padding: 0;
      margin: 0;
      transition: width 0.1s ease, opacity 0.2s ease;
    }

    .search-wrapper.typing .arch-search-input {
      opacity: 1;
    }

    .search-btn {
      position: relative;
      margin-left: 0;
      transition: margin-left 0.1s ease, color 0.2s ease;
      white-space: nowrap;
    }

    .search-wrapper.typing .search-btn {
      margin-left: 40px; /* Exakt 40px Abstand vor den getippten Wörtern */
    }

    .search-reset-icon { display: none; font-size: 20px; font-weight: 400; line-height: 1; }
    .search-wrapper.searched .search-btn-text { display: none; }
    .search-wrapper.searched .search-reset-icon { display: inline-block; }

    .mobile-arch-controls { display: none; }

    /* ==========================================================================
       ARCHIV PROJEKTZEILEN: HÖHE UM 1/3 VERRINGERT & ABSTÄNDE UM 30% GESTRAFFT
       ========================================================================== */
    .archive-project-row { 
      margin-bottom: 30px; /* 30% geringerer Abstand zwischen den Zeilen */
      width: 100%; 
    }
    
    .archive-carousel-bleed {
      width: 100vw;
      margin-left: -40px;
      padding-left: 40px;
      padding-right: 40px;
      scroll-padding-left: 40px;
      display: flex;
      align-items: center;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px; /* Näher an die Textzeile */
      cursor: grab;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* HÖHE UM 1/3 VERRINGERT (* 0.67) */
      height: calc((((100vw - 80px - 80px) / 4.3) * 0.67) + 8px);
    }
    .archive-carousel-bleed::-webkit-scrollbar { display: none; }
    
    .archive-item-flow { 
      position: relative; 
      height: calc(((100vw - 80px - 80px) / 4.3) * 0.67);
      width: auto;
      flex: 0 0 auto;
      scroll-snap-align: start; 
      overflow: hidden; 
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent !important;
      border: none !important;
    }
    
    .archive-media-flow { 
      height: 100%;
      width: auto;
      object-fit: contain;
      display: block;
      background: transparent !important; 
    }

    .color-placeholder-flow {
      height: 100%;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent !important;
      border: 1px dashed rgba(128,128,128,0.3);
      font-size: 14px;
    }
    
    .video-badge { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.75); color:#fff; font-size:11px; padding:2px 5px; border-radius:2px; z-index:2; }

    /* METADATEN ZEILE: NÄHER AN DIE BILDER GESCHOBEN (PADDING-TOP 4PX) */
    .archive-meta-grid { 
      display: grid; 
      grid-template-columns: repeat(12, 1fr); 
      column-gap: 20px; 
      font-size: 16px; 
      padding-top: 4px; 
    }
    .arch-name { grid-column: 1 / 5; font-weight: 500; }
    .arch-year { grid-column: 5 / 6; }
    .arch-context { grid-column: 6 / 10; white-space: pre-line !important; }
    .arch-info { grid-column: 10 / 11; position: relative; }
    .arch-info-btn {
      cursor: pointer;
      color: inherit;
      text-decoration: none !important;
      display: inline-block;
      user-select: none;
    }

    .arch-copyright { grid-column: 11 / 13; text-align: right; }

    .info-popover { display: none; position: absolute; bottom: 26px; left: 0; width: 320px; background: #000; color: #fff; padding: 14px; font-size: 16px; line-height: 1.2; z-index: 50; white-space: pre-line !important; }
    .arch-info:hover .info-popover { display: block; }
    .mobile-info-drawer { display: none; }

    .site-footer { padding-top: 80px; padding-bottom: 100px; }
    .footer-text-col { grid-column: 9 / 13; font-size: 24px; line-height: 1.2; white-space: pre-line !important; }
    .footer-text-col p { white-space: pre-line !important; }

    .lightbox-modal { display: none; position: fixed; inset: 0; background: #ffffff; z-index: 10000; padding: 30px 40px; flex-direction: column; justify-content: space-between; }
    .lightbox-modal.active { display: flex; }
    .lightbox-header { display: flex; justify-content: space-between; font-size: 16px; align-items: center; }
    .lightbox-stage { display: flex; align-items: center; justify-content: center; height: 75vh; width: 100%; background: transparent; }
    .lightbox-stage img, .lightbox-stage video { max-height: 100%; max-width: 100%; object-fit: contain; background: transparent; }
    .lightbox-footer { display: flex; justify-content: space-between; font-size: 16px; align-items: center; }
    .lightbox-arrows { display: flex; gap: 24px; }
    .arrow-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: inherit; padding: 4px 8px; }

    /* ==========================================================================
       MOBILE RESPONSIVE (<= 768px): 15% KLEINERE BILDER, 50% GESTRAFFTE ABSTÄNDE
       ========================================================================== */
    @media (max-width: 768px) {
      .hero-top-spacer { height: calc(50vh - 160px); }
      .hero-bottom-spacer { height: calc(50vh - 60px); }

      .sticky-nav { font-size: 20px; padding-top: 16px; padding-bottom: 16px; }
      .nav-brand { grid-column: 1 / 7; margin-bottom: 12px; transition: margin 0.35s ease; }

      .nav-bio-accordion {
        grid-column: 1 / 7;
        display: grid;
        grid-template-rows: 1fr;
        opacity: 1;
        margin-bottom: 12px;
        padding-right: 20%;
        transition: 
          grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.3s ease,
          margin-bottom 0.4s ease;
      }

      .nav-bio-inner {
        overflow: hidden;
        font-size: 20px;
        line-height: 1.2;
        padding-bottom: 8px;
      }

      .nav-collapsed-link {
        grid-column: 1 / 7;
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        margin-bottom: 0;
        transition: 
          grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.35s ease,
          margin-bottom 0.35s ease;
      }

      .nav-collapsed-inner {
        overflow: hidden;
        font-size: 20px;
        line-height: 1.2;
        padding-bottom: 8px;
        padding-top: 2px;
      }

      .nav-more { grid-column: 1 / 7; text-align: left; }

      .sticky-nav.collapsed .nav-brand { margin-bottom: 8px; }
      .sticky-nav.collapsed .nav-bio-accordion {
        grid-template-rows: 0fr;
        opacity: 0;
        margin-bottom: 0;
        pointer-events: none;
      }
      .sticky-nav.collapsed .nav-collapsed-link {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-bottom: 8px;
      }

      /* +50% MEHR ABSTAND AUF MOBILE (120PX MBL) */
      .selected-section { padding-bottom: 120px; }
      .section-title { font-size: 20px; margin-bottom: 0; }
      .selected-grid { grid-template-columns: 1fr; row-gap: 36px; margin-top: 20px; }
      .work-card { display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; align-items: start; }
      .scrub-container { aspect-ratio: 3 / 4 !important; margin-bottom: 0; }

      .mobile-thumb-box { display: block !important; width: 100%; height: 100%; position: relative; }
      .desktop-thumb-box { display: none !important; }
      .mobile-thumb-box img, .mobile-thumb-box video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .card-meta { display: flex; flex-direction: column; font-size: 16px; line-height: 1.2; }
      .meta-title { min-height: auto; margin-bottom: 19.2px !important; }
      .meta-context { min-height: auto; margin-bottom: 19.2px !important; }

      /* MOBILE ARCHIV HEADER */
      .archive-header-grid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }
      .arch-title-col { flex: 1; }
      .arch-sort-col, .arch-search-col { display: none; } /* Suche auf Mobile ausgeblendet */

      /* MOBILE UHR-ICON BUTTON */
      .mobile-arch-controls { display: flex; align-items: center; }
      .mobile-clock-btn {
        background: none;
        border: none;
        color: #999999;
        cursor: pointer;
        padding: 4px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s ease;
      }
      .mobile-clock-btn.active { color: #000000; }
      .sort-arrow-mobile { display: none; }
      .mobile-clock-btn.active .sort-arrow-mobile { display: inline-block; }
      .mobile-clock-btn.asc .sort-arrow-mobile { transform: rotate(180deg); }

      /* MOBILE ARCHIV: 15% KLEINERE HÖHE & 12PX BILD-ABSTAND */
      .archive-carousel-bleed { 
        margin-left: -40px; 
        padding-left: 40px; 
        padding-right: 40px;
        gap: 12px; /* Geringerer Abstand zwischen den Bildern */
        height: calc((((100vw - 80px - 20px) / 2) * 0.85) + 4px);
        padding-bottom: 4px;
      }
      
      .archive-item-flow { 
        height: calc(((100vw - 80px - 20px) / 2) * 0.85); /* 15% kleiner */
        width: auto;
      }

      /* 50% GESTRAFFTER ZEILEN-ABSTAND (22PX) */
      .archive-project-row {
        margin-bottom: 22px;
      }
      
      .archive-meta-grid {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 16px;
        width: 100%;
        padding-top: 2px;
      }

      .arch-name {
        flex: 1;
        min-width: 0;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        margin-right: 16px;
        transition: all 0.2s ease;
      }

      .archive-meta-grid.open .arch-name {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
      }

      .arch-info { flex-shrink: 0; }
      .arch-year, .arch-context, .arch-copyright { display: none; }
      .info-popover { display: none !important; }

      .mobile-info-drawer { 
        display: block; 
        max-height: 0; 
        opacity: 0; 
        overflow: hidden; 
        transition: all 0.3s ease; 
        font-size: 16px; 
        color: #000; 
      }
      .mobile-info-drawer.open { max-height: 500px; opacity: 1; margin-top: 8px; }
      .drawer-context { margin-bottom: 6px; }
      .drawer-desc { margin-bottom: 6px; white-space: pre-line !important; }
      .drawer-copyright { font-size: 14px; color: inherit; }

      .site-footer { padding-top: 60px; padding-bottom: 60px; }
      .footer-text-col { grid-column: 1 / 7; font-size: 20px; line-height: 1.2; }

      .lightbox-modal { padding: 20px; }
      .lightbox-header, .lightbox-footer { font-size: 14px; }
      .arrow-btn { font-size: 18px; }
    }
  </style>

  <script is:inline>
    // 1. Navbar Scroll Collapse
    const nav = document.getElementById('mainNav');
    const topSpacer = document.getElementById('topSpacer');

    function checkScroll() {
      const topSpacerHeight = topSpacer ? topSpacer.offsetHeight : (window.innerHeight * 0.4);
      if (window.scrollY >= (topSpacerHeight - 20)) {
        nav?.classList.add('collapsed');
      } else {
        nav?.classList.remove('collapsed');
      }
    }
    window.addEventListener('scroll', checkScroll, { passive: true });

    // 2. Video Autoplay Enforcer
    function playAllVideos() {
      document.querySelectorAll('video').forEach(v => {
        v.muted = true;
        v.playsInline = true;
        const p = v.play();
        if (p && typeof p.catch === 'function') {
          p.catch(() => {});
        }
      });
    }
    window.addEventListener('DOMContentLoaded', playAllVideos);
    window.addEventListener('load', playAllVideos);
    document.addEventListener('touchstart', playAllVideos, { once: true });

    // 3. Desktop Hover Scrubbing
    document.querySelectorAll('.desktop-thumb-box').forEach(box => {
      const items = box.querySelectorAll('.scrub-item');
      const count = items.length;
      if (count > 1) {
        box.addEventListener('mousemove', (e) => {
          if (window.innerWidth <= 768) return;
          const rect = box.getBoundingClientRect();
          const activeIndex = Math.floor(Math.max(0, Math.min(0.999, (e.clientX - rect.left) / rect.width)) * count);
          items.forEach((item, i) => item.classList.toggle('active', i === activeIndex));
        });
        box.addEventListener('mouseleave', () => {
          items.forEach((item, i) => item.classList.toggle('active', i === 0));
        });
      }
    });

    // 4. Info Drawer Toggle
    document.querySelectorAll('.arch-info-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (window.innerWidth > 768) return;
        const row = btn.closest('.archive-project-row');
        row.querySelector('.mobile-info-drawer')?.classList.toggle('open');
        row.querySelector('.archive-meta-grid')?.classList.toggle('open');
      });
    });

    // 5. ZEIT-SORTIERUNG (DESKTOP & MOBILE)
    let timeSortState = 0; // 0 = Default (order), 1 = Descending (Neueste zuerst), 2 = Ascending (Älteste zuerst)
    const timeBtn = document.getElementById('timeSortBtn');
    const mobileTimeBtn = document.getElementById('mobileTimeSortBtn');
    const archContainer = document.getElementById('archiveContainer');

    function applyTimeSort(nextState) {
      timeSortState = nextState;
      const rows = Array.from(archContainer.querySelectorAll('.archive-project-row'));

      if (timeSortState === 1) {
        // Neueste zuerst (absteigend)
        rows.sort((a, b) => (parseInt(b.dataset.year) || 0) - (parseInt(a.dataset.year) || 0));
        timeBtn?.classList.add('active');
        timeBtn?.classList.remove('asc');
        mobileTimeBtn?.classList.add('active');
        mobileTimeBtn?.classList.remove('asc');
      } else if (timeSortState === 2) {
        // Älteste zuerst (aufsteigend)
        rows.sort((a, b) => (parseInt(a.dataset.year) || 0) - (parseInt(b.dataset.year) || 0));
        timeBtn?.classList.add('active', 'asc');
        mobileTimeBtn?.classList.add('active', 'asc');
      } else {
        // Standard Reihenfolge (order)
        rows.sort((a, b) => (parseInt(a.dataset.order) || 0) - (parseInt(b.dataset.order) || 0));
        timeBtn?.classList.remove('active', 'asc');
        mobileTimeBtn?.classList.remove('active', 'asc');
        timeSortState = 0;
      }

      rows.forEach(r => archContainer.appendChild(r));
    }

    timeBtn?.addEventListener('click', () => {
      applyTimeSort((timeSortState + 1) % 3);
    });

    mobileTimeBtn?.addEventListener('click', () => {
      applyTimeSort((timeSortState + 1) % 3);
    });

    // 6. DYNAMISCHE SUCHE MIT 40PX MITLAUFENDEM BUTTON
    const searchWrapper = document.getElementById('searchWrapper');
    const searchInput = document.getElementById('archSearchInput');
    const searchBtn = document.getElementById('archSearchBtn');
    const searchMirror = document.getElementById('searchMirror');
    const noMatches = document.getElementById('noSearchMatches');
    const searchCol = document.querySelector('.arch-search-col');

    let isSearchActive = false;

    function updateSearchButtonPosition() {
      if (!searchInput || !searchMirror || !searchCol) return;
      searchMirror.textContent = searchInput.value || '';
      const textWidth = searchMirror.offsetWidth;
      const maxColWidth = searchCol.offsetWidth;
      
      // Berechnet die Inputbreite dynamisch, lässt 80px für den Button frei
      const targetInputWidth = Math.min(maxColWidth - 90, textWidth + 8);
      searchInput.style.width = targetInputWidth + 'px';
    }

    searchBtn?.addEventListener('click', () => {
      // Wenn bereits gesucht wurde: Klick auf X setzt die Suche zurück
      if (searchWrapper?.classList.contains('searched')) {
        resetSearch();
        return;
      }

      if (!isSearchActive) {
        // Suche aktivieren & Input öffnen
        isSearchActive = true;
        searchWrapper?.classList.add('typing');
        searchInput.focus();
        updateSearchButtonPosition();
      } else {
        // Suche ausführen
        executeSearch();
      }
    });

    searchInput?.addEventListener('input', () => {
      updateSearchButtonPosition();
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        executeSearch();
      }
      if (e.key === 'Escape') {
        resetSearch();
      }
    });

    function executeSearch() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      if (!q) {
        resetSearch();
        return;
      }

      searchWrapper?.classList.add('searched');
      const rows = document.querySelectorAll('.archive-project-row');
      let visibleCount = 0;

      rows.forEach((row: any) => {
        const hay = row.dataset.search || '';
        if (hay.includes(q)) {
          row.style.display = 'block';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noMatches) noMatches.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function resetSearch() {
      isSearchActive = false;
      if (searchInput) {
        searchInput.value = '';
        searchInput.style.width = '0px';
      }
      searchWrapper?.classList.remove('typing', 'searched');
      
      const rows = document.querySelectorAll('.archive-project-row');
      rows.forEach((r: any) => r.style.display = 'block');
      if (noMatches) noMatches.style.display = 'none';
    }

    // 7. Global Lightbox mit Deep-Linking
    const lb = document.getElementById('globalLightbox');
    const lbTitle = document.getElementById('lbTitle');
    const lbCopyright = document.getElementById('lbCopyright');
    const lbStage = document.getElementById('lbStage');
    const lbPrev = document.getElementById('lbPrev');
    const lbNext = document.getElementById('lbNext');

    const archiveItems = Array.from(document.querySelectorAll('.archive-item-flow'));
    let currentLbIndex = 0;

    function renderLightboxItem(index, updateUrl = true) {
      if (index < 0) index = archiveItems.length - 1;
      if (index >= archiveItems.length) index = 0;
      currentLbIndex = index;

      const item = archiveItems[currentLbIndex];
      if (!item) return;

      const title = item.dataset.title || '';
      const year = item.dataset.year || '';
      const copyright = item.dataset.copyright || '';
      const src = item.dataset.src || item.querySelector('img')?.src || '';
      const video = item.dataset.video || '';
      const itemId = item.dataset.id || '';

      lbTitle.innerText = `${title} (${year})`;
      lbCopyright.innerText = `© ${copyright}`;

      if (video) {
        lbStage.innerHTML = `<video src="${video}" autoplay controls playsinline webkit-playsinline loop style="max-height:100%; max-width:100%; object-fit:contain; background:transparent;"></video>`;
      } else if (src) {
        lbStage.innerHTML = `<img src="${src}" alt="${title}" style="max-height:100%; max-width:100%; object-fit:contain; background:transparent;" />`;
      } else {
        lbStage.innerHTML = `<div style="font-size:16px; color:#999;">[ Kein Medium hinterlegt ]</div>`;
      }

      if (updateUrl && itemId) {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('view', itemId);
        window.history.replaceState({}, '', newUrl);
      }
    }

    archiveItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        renderLightboxItem(idx, true);
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    lbPrev?.addEventListener('click', () => renderLightboxItem(currentLbIndex - 1, true));
    lbNext?.addEventListener('click', () => renderLightboxItem(currentLbIndex + 1, true));
    
    document.getElementById('lbClose')?.addEventListener('click', () => {
      lb.classList.remove('active');
      document.body.style.overflow = 'auto';
      lbStage.innerHTML = '';
      
      const cleanUrl = new URL(window.location);
      cleanUrl.searchParams.delete('view');
      window.history.replaceState({}, '', cleanUrl.pathname + (cleanUrl.search ? '?' + cleanUrl.searchParams.toString() : ''));
    });

    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const viewId = params.get('view');
      if (viewId) {
        const targetIdx = archiveItems.findIndex(item => item.dataset.id === viewId);
        if (targetIdx !== -1) {
          renderLightboxItem(targetIdx, false);
          lb.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }
    });
  </script>
</Layout>  return text
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="wavy-link">$1</a>')
    .replace(/~(.*?)~/g, '<span class="wavy-text">$1</span>');
}

const brandName = settings.brandName || 'paulchen.at';
const navbarBio = settings.navbarBio || 'paul neuburger’s archive showcases ~conceptual thinking~, driven by a heavy focus on visual solutions and authentic new ways to communicate. Specialising in ~typography~ and spaces loaded with orientation and ~identity~.';
const contactLabel = settings.contactLinkText || 'write me';
const contactPrefix = settings.contactType === 'email' ? 'mailto:' : settings.contactType === 'tel' ? 'tel:' : '';
const contactHref = settings.contactTarget ? `${contactPrefix}${settings.contactTarget}` : 'mailto:hallo@paulchen.at';
const moreLabel = settings.moreButtonText || 'mehr';
const selectedWorkTitle = settings.selectedWorkTitle || 'Ausgewählte Projekte';
const archiveTitle = settings.archiveTitle || 'Archiv';
const footerText = settings.footerText || 'Your privacy matters to me. When you browse my design work on paulchen.at, your visit remains completely anonymous, ~no cookies~ are stored, tracked, or shared with third parties.\n\nYou can find all legal details regarding my identity in the [Imprint](/imprint) and full information about data handling in the [Privacy Policy](/privacy-policy).\n\nHave a wonderful day!\nBest, Paul';
---

<Layout 
  title={seo.siteTitle || "paulchen.at — Creative Direction & Archive"}
  description={seo.metaDescription}
  ogImage={seo.ogImage}
  favicon={seo.favicon}
>
  
  <div class="hero-top-spacer" id="topSpacer"></div>

  <!-- NAVBAR -->
  <header class="sticky-nav nav-grid" id="mainNav">
    <div class="nav-brand">
      <a href="/" class="wavy-link">{brandName}</a>
    </div>
    
    <div class="nav-bio-accordion">
      <div class="nav-bio-inner">
        <span set:html={parseFormattedText(navbarBio)} /> <a href={contactHref} class="wavy-link">{contactLabel}</a>
      </div>
    </div>

    <div class="nav-collapsed-link">
      <div class="nav-collapsed-inner">
        <a href={contactHref} class="wavy-link">{contactLabel}</a>
      </div>
    </div>

    <div class="nav-more">
      <a href="/ueber-mich" class="hover-wavy">{moreLabel}</a>
    </div>
  </header>

  <div class="hero-bottom-spacer"></div>

  <main>
    
    <!-- SELECTED WORK -->
    <section class="selected-section content-grid">
      <div style="grid-column: 1 / -1;">
        <h2 class="section-title">{selectedWorkTitle}</h2>
        
        <div class="selected-grid">
          {projects.length > 0 ? (
            projects.map((proj) => {
              const d = proj.data || {};
              const { mobileImage, mobileVideo, desktopImages, desktopVideo } = getProjectThumbnails(d);

              return (
                <article class="work-card">
                  <a href={`/projects/${proj.slug}`} style="color:inherit; text-decoration:none;">
                    <div class="scrub-container">
                      
                      <!-- 📱 MOBILE THUMBNAIL -->
                      <div class="mobile-thumb-box">
                        {mobileVideo ? (
                          <video 
                            src={mobileVideo} 
                            autoplay 
                            loop 
                            muted 
                            playsinline 
                            webkit-playsinline 
                            preload="auto"
                            class="thumb-media-full" 
                          />
                        ) : mobileImage ? (
                          <img src={mobileImage} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : desktopVideo ? (
                          <video 
                            src={desktopVideo} 
                            autoplay 
                            loop 
                            muted 
                            playsinline 
                            webkit-playsinline 
                            preload="auto"
                            class="thumb-media-full" 
                          />
                        ) : desktopImages.length > 0 ? (
                          <img src={desktopImages[0]} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : (
                          <div class="color-placeholder"><span>3:4</span></div>
                        )}
                      </div>

                      <!-- 🖥️ DESKTOP THUMBNAIL -->
                      <div class="desktop-thumb-box">
                        {desktopVideo ? (
                          <video 
                            src={desktopVideo} 
                            autoplay 
                            loop 
                            muted 
                            playsinline 
                            webkit-playsinline 
                            preload="auto"
                            class="thumb-media-full" 
                          />
                        ) : desktopImages.length > 0 ? (
                          desktopImages.map((imgSrc: string, idx: number) => (
                            <img 
                              src={imgSrc} 
                              alt={d.title || ''} 
                              class={`scrub-item ${idx === 0 ? 'active' : ''}`}
                              loading={idx === 0 ? "eager" : "lazy"}
                              decoding="async"
                            />
                          ))
                        ) : mobileImage ? (
                          <img src={mobileImage} alt={d.title || ''} class="thumb-media-full" loading="lazy" decoding="async" />
                        ) : (
                          <div class="color-placeholder"><span>4:3</span></div>
                        )}
                      </div>

                    </div>
                  </a>
                  
                  <div class="card-meta">
                    <div class="meta-title"><p>{d.title || ''}</p></div>
                    <div class="meta-context"><p>{d.furtherContext || ''}</p></div>
                    <div class="meta-year-place"><p>{d.year || ''} {d.location || ''}</p></div>
                    <div class="meta-copyright"><p>{d.copyright || ''}</p></div>
                  </div>
                </article>
              );
            })
          ) : (
            <p style="grid-column: 1 / -1; font-size: 16px; color: #888;">Keine Projekte angelegt.</p>
          )}
        </div>
      </div>
    </section>

    <!-- ARCHIV (FESTE ZEILENHÖHE + NATÜRLICHE BILDBREITEN OHNE LÜCKEN) -->
    <section class="archive-section content-grid">
      <div style="grid-column: 1 / -1;">
        <h2 class="section-title">{archiveTitle}</h2>

        {archiveRows.map((row: any) => {
          const rowSlug = (row.title || 'item').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
          return (
            <div class="archive-project-row">
              <div class="archive-carousel-bleed">
                {row.gallery && row.gallery.map((item: any, gIdx: number) => {
                  const videoSrc = item.videoFile || item.videoUrl || '';
                  const itemId = `${rowSlug}-${gIdx + 1}`;
                  return (
                    <div 
                      class="archive-item-flow" 
                      data-id={itemId}
                      data-title={row.title || ''} 
                      data-year={row.year || ''} 
                      data-copyright={row.copyright || ''}
                      data-src={item.mediaFile || ''}
                      data-video={videoSrc}
                    >
                      {(item.isVideo || videoSrc) && <div class="video-badge">Video</div>}
                      {videoSrc ? (
                        <video 
                          src={videoSrc} 
                          muted 
                          loop 
                          playsinline 
                          webkit-playsinline 
                          preload="metadata"
                          class="archive-media-flow" 
                        />
                      ) : item.mediaFile ? (
                        <img 
                          src={item.mediaFile} 
                          alt={row.title || ''} 
                          loading="lazy" 
                          decoding="async" 
                          class="archive-media-flow"
                        />
                      ) : (
                        <div class="color-placeholder-flow">1:1</div>
                      )}
                    </div>
                  );
                })}
              </div>
              
              <!-- 12-SPALTEN RASTER -->
              <div class="archive-meta-grid">
                <div class="arch-name">{row.title || ''}</div>
                <div class="arch-year">({row.year || ''})</div>
                <div class="arch-context">{row.furtherContext || ''}</div>
                <div class="arch-info">
                  <span class="arch-info-btn">Info</span>
                  <div class="info-popover">{row.infoText || ''}</div>
                </div>
                <div class="arch-copyright">{row.copyright || ''}</div>
              </div>

              <!-- MOBILE INFO DRAWER -->
              <div class="mobile-info-drawer">
                {row.furtherContext && <div class="drawer-context">Mitwirkende: {row.furtherContext} ({row.year || ''})</div>}
                {row.infoText && <div class="drawer-desc">{row.infoText}</div>}
                {row.copyright && <div class="drawer-copyright">© {row.copyright}</div>}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="content-grid site-footer">
      <div class="footer-text-col">
        <p set:html={parseFormattedText(footerText)} />
      </div>
    </footer>

  </main>

  <!-- LIGHTBOX -->
  <div class="lightbox-modal" id="globalLightbox">
    <div class="lightbox-header">
      <span id="lbTitle">Projekt Titel</span>
      <span style="cursor:pointer;" id="lbClose" class="hover-wavy">(Close ✕)</span>
    </div>
    <div class="lightbox-stage" id="lbStage">
      <div id="lbMedia">[ Lade Bild... ]</div>
    </div>
    <div class="lightbox-footer">
      <span id="lbContext">Global Archive</span>
      <div class="lightbox-arrows">
        <button id="lbPrev" class="arrow-btn hover-wavy" aria-label="Vorheriges">←</button>
        <button id="lbNext" class="arrow-btn hover-wavy" aria-label="Nächstes">→</button>
      </div>
      <span id="lbCopyright">© Copyright</span>
    </div>
  </div>

  <style>
    .hero-top-spacer { height: calc(50vh - 85px); width: 100%; }
    .hero-bottom-spacer { height: calc(50vh + 100px); width: 100%; }

    .sticky-nav { position: sticky; top: 0; z-index: 999; background: transparent; padding-top: 20px; padding-bottom: 20px; font-size: 24px; pointer-events: none; }
    .sticky-nav a, .sticky-nav span { pointer-events: auto; }
    .nav-brand { grid-column: 1 / 3; }
    
    .nav-bio-accordion { grid-column: 3 / 11; display: block; opacity: 1; }
    .nav-bio-inner { font-size: 24px; line-height: 1.2; white-space: pre-line !important; }
    .nav-collapsed-link { display: none; }

    .nav-more { grid-column: 11 / 13; text-align: right; }

    .selected-section { padding-bottom: 180px; }
    .section-title { font-size: 24px; margin-bottom: 24px; font-weight: 400; }
    .selected-grid { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 20px; row-gap: 60px; }

    .work-card { display: flex; flex-direction: column; }
    
    .scrub-container { 
      position: relative; 
      width: 100%; 
      aspect-ratio: 4 / 3; 
      background-color: transparent !important; 
      border: none !important;
      overflow: hidden; 
      margin-bottom: 14px; 
    }
    
    .scrub-item { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none; transition: opacity 0.04s ease; background: transparent; }
    .scrub-item.active { opacity: 1; }

    .mobile-thumb-box { display: none; }
    .desktop-thumb-box { display: block; width: 100%; height: 100%; position: relative; cursor: crosshair; background: transparent; }
    .thumb-media-full { 
      position: absolute; 
      inset: 0; 
      width: 100%; 
      height: 100%; 
      object-fit: cover; 
      background: transparent;
      pointer-events: none !important;
    }

    .color-placeholder { 
      position: absolute; 
      inset: 0; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center; 
      color: inherit; 
      font-size: 16px; 
      font-weight: 500; 
      letter-spacing: 0.5px;
      background: transparent !important;
      border: 1px dashed rgba(128,128,128,0.3);
    }

    .card-meta { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; font-size: 16px; line-height: 1.2; }
    .card-meta p { white-space: pre-line !important; }
    .meta-title { grid-column: 1; grid-row: 1; min-height: 57.6px; }
    .meta-year-place { grid-column: 1; grid-row: 2; }
    .meta-context { grid-column: 2; grid-row: 1; min-height: 57.6px; }
    .meta-copyright { grid-column: 2; grid-row: 2; }

    /* ==========================================================================
       ARCHIV: FESTE ZEILENHÖHE & NATÜRLICHE BILDBREITEN OHNE LÜCKEN
       ========================================================================== */
    .archive-section { padding-bottom: 60px; overflow-x: hidden; }
    .archive-project-row { margin-bottom: 44px; width: 100%; }
    
    .archive-carousel-bleed {
      width: 100vw;
      margin-left: -40px;
      padding-left: 40px;
      padding-right: 40px;
      scroll-padding-left: 40px;
      display: flex;
      align-items: center;
      gap: 20px; /* Exakt 20px Abstand zwischen allen Bildern */
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 14px;
      cursor: grab;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Feste Zeilenhöhe auf Desktop basierend auf dem 4-Spalten-Raster */
      height: calc(((100vw - 80px - 80px) / 4.3) + 14px);
    }
    .archive-carousel-bleed::-webkit-scrollbar { display: none; }
    
    /* Dynamischer Bild-Container: Nimmt nur exakt so viel Breite ein wie nötig */
    .archive-item-flow { 
      position: relative; 
      height: calc((100vw - 80px - 80px) / 4.3);
      width: auto;
      flex: 0 0 auto;
      scroll-snap-align: start; 
      overflow: hidden; 
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent !important;
      border: none !important;
    }
    
    /* Bild & Video behalten echte Proportionen bei voller Höhe */
    .archive-media-flow { 
      height: 100%;
      width: auto;
      object-fit: contain;
      display: block;
      background: transparent !important; 
    }

    .color-placeholder-flow {
      height: 100%;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent !important;
      border: 1px dashed rgba(128,128,128,0.3);
      font-size: 14px;
    }
    
    .video-badge { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.75); color:#fff; font-size:12px; padding:3px 6px; border-radius:2px; z-index:2; }

    .archive-meta-grid { 
      display: grid; 
      grid-template-columns: repeat(12, 1fr); 
      column-gap: 20px; 
      font-size: 16px; 
      padding-top: 6px; 
    }
    .arch-name { grid-column: 1 / 5; font-weight: 500; }
    .arch-year { grid-column: 5 / 6; }
    .arch-context { grid-column: 6 / 10; white-space: pre-line !important; }
    .arch-info { grid-column: 10 / 11; position: relative; }
    .arch-info-btn {
      cursor: pointer;
      color: inherit;
      text-decoration: none !important;
      display: inline-block;
      user-select: none;
    }

    .arch-copyright { grid-column: 11 / 13; text-align: right; }

    .info-popover { display: none; position: absolute; bottom: 26px; left: 0; width: 320px; background: #000; color: #fff; padding: 14px; font-size: 16px; line-height: 1.2; z-index: 50; white-space: pre-line !important; }
    .arch-info:hover .info-popover { display: block; }
    .mobile-info-drawer { display: none; }

    .site-footer { padding-top: 80px; padding-bottom: 100px; }
    .footer-text-col { grid-column: 9 / 13; font-size: 24px; line-height: 1.2; white-space: pre-line !important; }
    .footer-text-col p { white-space: pre-line !important; }

    .lightbox-modal { display: none; position: fixed; inset: 0; background: #ffffff; z-index: 10000; padding: 30px 40px; flex-direction: column; justify-content: space-between; }
    .lightbox-modal.active { display: flex; }
    .lightbox-header { display: flex; justify-content: space-between; font-size: 16px; align-items: center; }
    .lightbox-stage { display: flex; align-items: center; justify-content: center; height: 75vh; width: 100%; background: transparent; }
    .lightbox-stage img, .lightbox-stage video { max-height: 100%; max-width: 100%; object-fit: contain; background: transparent; }
    .lightbox-footer { display: flex; justify-content: space-between; font-size: 16px; align-items: center; }
    .lightbox-arrows { display: flex; gap: 24px; }
    .arrow-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: inherit; padding: 4px 8px; }

    @media (max-width: 768px) {
      .hero-top-spacer { height: calc(50vh - 160px); }
      .hero-bottom-spacer { height: calc(50vh - 60px); }

      .sticky-nav { font-size: 20px; padding-top: 16px; padding-bottom: 16px; }
      .nav-brand { grid-column: 1 / 7; margin-bottom: 12px; transition: margin 0.35s ease; }

      .nav-bio-accordion {
        grid-column: 1 / 7;
        display: grid;
        grid-template-rows: 1fr;
        opacity: 1;
        margin-bottom: 12px;
        padding-right: 20%;
        transition: 
          grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.3s ease,
          margin-bottom 0.4s ease;
      }

      .nav-bio-inner {
        overflow: hidden;
        font-size: 20px;
        line-height: 1.2;
        padding-bottom: 8px;
      }

      .nav-collapsed-link {
        grid-column: 1 / 7;
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        margin-bottom: 0;
        transition: 
          grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.35s ease,
          margin-bottom 0.35s ease;
      }

      .nav-collapsed-inner {
        overflow: hidden;
        font-size: 20px;
        line-height: 1.2;
        padding-bottom: 8px;
        padding-top: 2px;
      }

      .nav-more { grid-column: 1 / 7; text-align: left; }

      .sticky-nav.collapsed .nav-brand { margin-bottom: 8px; }
      .sticky-nav.collapsed .nav-bio-accordion {
        grid-template-rows: 0fr;
        opacity: 0;
        margin-bottom: 0;
        pointer-events: none;
      }
      .sticky-nav.collapsed .nav-collapsed-link {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-bottom: 8px;
      }

      .section-title { font-size: 20px; margin-bottom: 20px; }
      .selected-section { padding-bottom: 80px; }
      .selected-grid { grid-template-columns: 1fr; row-gap: 36px; }
      .work-card { display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; align-items: start; }
      .scrub-container { aspect-ratio: 3 / 4 !important; margin-bottom: 0; }

      .mobile-thumb-box { display: block !important; width: 100%; height: 100%; position: relative; }
      .desktop-thumb-box { display: none !important; }
      .mobile-thumb-box img, .mobile-thumb-box video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .card-meta { display: flex; flex-direction: column; font-size: 16px; line-height: 1.2; }
      .meta-title { min-height: auto; margin-bottom: 19.2px !important; }
      .meta-context { min-height: auto; margin-bottom: 19.2px !important; }

      /* ARCHIV MOBILE: FLIESSENDE BREITEN */
      .archive-carousel-bleed { 
        margin-left: -40px; 
        padding-left: 40px; 
        padding-right: 40px;
        height: calc(((100vw - 80px - 20px) / 2) + 14px);
      }
      
      .archive-item-flow { 
        height: calc((100vw - 80px - 20px) / 2);
        width: auto;
      }
      
      .archive-meta-grid {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 16px;
        width: 100%;
      }

      .arch-name {
        flex: 1;
        min-width: 0;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        margin-right: 16px;
        transition: all 0.2s ease;
      }

      .archive-meta-grid.open .arch-name {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
      }

      .arch-info { flex-shrink: 0; }
      .arch-year, .arch-context, .arch-copyright { display: none; }
      .info-popover { display: none !important; }

      .mobile-info-drawer { 
        display: block; 
        max-height: 0; 
        opacity: 0; 
        overflow: hidden; 
        transition: all 0.3s ease; 
        font-size: 16px; 
        color: #000; 
      }
      .mobile-info-drawer.open { max-height: 500px; opacity: 1; margin-top: 10px; }
      .drawer-context { margin-bottom: 6px; }
      .drawer-desc { margin-bottom: 6px; white-space: pre-line !important; }
      .drawer-copyright { font-size: 14px; color: inherit; }

      .site-footer { padding-top: 60px; padding-bottom: 60px; }
      .footer-text-col { grid-column: 1 / 7; font-size: 20px; line-height: 1.2; }

      .lightbox-modal { padding: 20px; }
      .lightbox-header, .lightbox-footer { font-size: 14px; }
      .arrow-btn { font-size: 18px; }
    }
  </style>

  <script is:inline>
    // 1. Navbar Scroll Collapse
    const nav = document.getElementById('mainNav');
    const topSpacer = document.getElementById('topSpacer');

    function checkScroll() {
      const topSpacerHeight = topSpacer ? topSpacer.offsetHeight : (window.innerHeight * 0.4);
      if (window.scrollY >= (topSpacerHeight - 20)) {
        nav?.classList.add('collapsed');
      } else {
        nav?.classList.remove('collapsed');
      }
    }

    window.addEventListener('scroll', checkScroll, { passive: true });

    // 2. Video Autoplay Enforcer
    function playAllVideos() {
      document.querySelectorAll('video').forEach(v => {
        v.muted = true;
        v.playsInline = true;
        const p = v.play();
        if (p && typeof p.catch === 'function') {
          p.catch(() => {});
        }
      });
    }

    window.addEventListener('DOMContentLoaded', playAllVideos);
    window.addEventListener('load', playAllVideos);
    document.addEventListener('touchstart', playAllVideos, { once: true });

    // 3. Desktop Hover Scrubbing
    document.querySelectorAll('.desktop-thumb-box').forEach(box => {
      const items = box.querySelectorAll('.scrub-item');
      const count = items.length;

      if (count > 1) {
        box.addEventListener('mousemove', (e) => {
          if (window.innerWidth <= 768) return;
          
          const rect = box.getBoundingClientRect();
          const mouseX = e.clientX - rect.left;
          const ratio = Math.max(0, Math.min(0.999, mouseX / rect.width));
          const activeIndex = Math.floor(ratio * count);

          items.forEach((item, i) => {
            if (i === activeIndex) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
        });

        box.addEventListener('mouseleave', () => {
          items.forEach((item, i) => {
            if (i === 0) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
        });
      }
    });

    // 4. Info Drawer Toggle
    document.querySelectorAll('.arch-info-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (window.innerWidth > 768) return;
        const row = btn.closest('.archive-project-row');
        row.querySelector('.mobile-info-drawer')?.classList.toggle('open');
        row.querySelector('.archive-meta-grid')?.classList.toggle('open');
      });
    });

    // 5. Global Lightbox mit Deep-Linking
    const lb = document.getElementById('globalLightbox');
    const lbTitle = document.getElementById('lbTitle');
    const lbCopyright = document.getElementById('lbCopyright');
    const lbStage = document.getElementById('lbStage');
    const lbPrev = document.getElementById('lbPrev');
    const lbNext = document.getElementById('lbNext');

    const archiveItems = Array.from(document.querySelectorAll('.archive-item-flow'));
    let currentLbIndex = 0;

    function renderLightboxItem(index, updateUrl = true) {
      if (index < 0) index = archiveItems.length - 1;
      if (index >= archiveItems.length) index = 0;
      currentLbIndex = index;

      const item = archiveItems[currentLbIndex];
      if (!item) return;

      const title = item.dataset.title || '';
      const year = item.dataset.year || '';
      const copyright = item.dataset.copyright || '';
      const src = item.dataset.src || item.querySelector('img')?.src || '';
      const video = item.dataset.video || '';
      const itemId = item.dataset.id || '';

      lbTitle.innerText = `${title} (${year})`;
      lbCopyright.innerText = `© ${copyright}`;

      if (video) {
        lbStage.innerHTML = `<video src="${video}" autoplay controls playsinline webkit-playsinline loop style="max-height:100%; max-width:100%; object-fit:contain; background:transparent;"></video>`;
      } else if (src) {
        lbStage.innerHTML = `<img src="${src}" alt="${title}" style="max-height:100%; max-width:100%; object-fit:contain; background:transparent;" />`;
      } else {
        lbStage.innerHTML = `<div style="font-size:16px; color:#999;">[ Kein Medium hinterlegt ]</div>`;
      }

      if (updateUrl && itemId) {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('view', itemId);
        window.history.replaceState({}, '', newUrl);
      }
    }

    archiveItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        renderLightboxItem(idx, true);
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    lbPrev?.addEventListener('click', () => renderLightboxItem(currentLbIndex - 1, true));
    lbNext?.addEventListener('click', () => renderLightboxItem(currentLbIndex + 1, true));
    
    document.getElementById('lbClose')?.addEventListener('click', () => {
      lb.classList.remove('active');
      document.body.style.overflow = 'auto';
      lbStage.innerHTML = '';
      
      const cleanUrl = new URL(window.location);
      cleanUrl.searchParams.delete('view');
      window.history.replaceState({}, '', cleanUrl.pathname + (cleanUrl.search ? '?' + cleanUrl.searchParams.toString() : ''));
    });

    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const viewId = params.get('view');
      if (viewId) {
        const targetIdx = archiveItems.findIndex(item => item.dataset.id === viewId);
        if (targetIdx !== -1) {
          renderLightboxItem(targetIdx, false);
          lb.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }
    });
  </script>
</Layout>
